{
  "compilerOptions": {
    "rootDir": "web/src/engine",
    "outDir": "web/classic/js/engine",
    "target": "ES2022",
    "module": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noEmitOnError": false,
    "removeComments": false,
    "types": []
  },
  "include": ["web/src/engine/*.ts"]
}
